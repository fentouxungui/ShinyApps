output_dir <- "C:/Users/Xi_Lab/Desktop/SeuratExplorer-Desktop-Build"
# 2. 【核心修正】直接通过函数参数，强制指定为 "bundled" 模式
# 这样它就会去下载免安装版 R (portable-r)，而不是走网页版的 shinylive
options(timeout = 3600)
export(
appdir = app_dir,
destdir = output_dir,
runtime_strategy = "bundled",  # <-- 关键修正：强行锁定捆绑 R 模式
run_after = FALSE,
overwrite = TRUE
)
?export
install.packages('Seurat')
setwd("D:/GitHub_Res/ShinyApps")
