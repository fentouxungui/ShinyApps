{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fentouxungui.github.io/ShinyApps/state.schema.json",
  "title": "ShinyApps local install state (userData/state.json)",
  "type": "object",
  "required": ["schema", "apps", "shared"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "apps": {
      "type": "object",
      "description": "Installed apps keyed by app id",
      "additionalProperties": {
        "type": "object",
        "required": ["version", "platform", "dir", "packages"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "platform": { "type": "string", "enum": ["win-x64", "win-arm64", "mac-x64", "mac-arm64", "linux-x64"] },
          "dir": { "type": "string", "description": "Absolute path to the unpacked bundle version dir" },
          "packages": { "type": "array", "items": { "type": "string" }, "description": "Package names this app depends on (bundle manifest closure)" }
        }
      }
    },
    "shared": {
      "type": "object",
      "description": "Reference-counted shared R package library, keyed by package name",
      "additionalProperties": {
        "type": "object",
        "required": ["version", "refs"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" }, "description": "App ids that currently reference this package" }
        }
      }
    }
  }
}
